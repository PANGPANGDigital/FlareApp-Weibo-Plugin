{
  "$schema": "https://unpkg.com/flare-plugin-sdk@0.1.0-beta.10/skill/flare-plugin/manifest.schema.json",
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "local.plugin.p1568372ac69c4df8a99cff8ad3f57936",
  "version": "0.3.3",
  "name": "Weibo Enhance",
  "description": "微博最新时间线与超话自动签到：刷新时间线时自动完成超话签到。",
  "permissions": {
    "authOrigins": [
      "https://m.weibo.cn",
      "https://passport.weibo.com",
      "https://passport.weibo.cn",
      "https://login.sina.com.cn"
    ],
    "mediaNetwork": true
  },
  "platform": {
    "id": "Plugin1568372ac69c4df8a99cff8ad3f57936",
    "name": "Weibo Enhance",
    "description": "微博增强版 (支持超话自动签到)",
    "credentialSchemaVersion": 3,
    "detector": {
      "priority": 1000
    },
    "loginMethods": [
      {
        "id": "browser",
        "interaction": "WebCookie",
        "title": "使用微博网页登录 (Weibo Enhance)",
        "cookie": {
          "startUrl": "https://passport.weibo.com/sso/signin?entry=wapsso&source=wapssowb&url=https%3A%2F%2Fm.weibo.cn%2F",
          "probes": [
            {
              "url": "$accountOrigin/api/config",
              "cookies": [
                { "name": "SUB", "required": true },
                { "name": "SUBP", "required": false },
                { "name": "_T_WM", "required": false },
                { "name": "MLOGIN", "required": false },
                { "name": "ALF", "required": false },
                { "name": "XSRF-TOKEN", "required": false }
              ]
            }
          ]
        }
      }
    ],
    "composeDefaults": {
      "text": {
        "maxLength": 5000
      },
      "visibility": {
        "allowed": [
          "public"
        ],
        "default": "public"
      }
    },
    "capabilities": {
      "flare.datasource.timeline/v1": {
        "operations": {
          "page": {
            "directions": [
              "refresh",
              "older"
            ]
          }
        }
      },
      "flare.datasource.tab-catalog/v1": {
        "operations": {
          "page": {}
        }
      },
      "flare.datasource.post/v1": {
        "operations": {
          "detail": {},
          "context": {},
          "mutate": {}
        }
      },
      "flare.datasource.compose/v1": {
        "operations": {
          "publish": {}
        }
      },
      "flare.datasource.profile/v1": {
        "operations": {
          "byId": {},
          "byHandle": {}
        }
      }
    },
    "timelines": [
      {
        "id": "checkin",
        "title": "最新微博Enhance",
        "icon": "Home",
        "defaultForNewAccount": true
      },
      {
        "id": "friends",
        "title": "好友圈",
        "icon": "Heart",
        "defaultForNewAccount": true
      },
      {
        "id": "special",
        "title": "特别关注",
        "icon": "Featured",
        "defaultForNewAccount": true
      }
    ]
  }
}
