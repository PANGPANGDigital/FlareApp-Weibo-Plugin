{
  "$schema": "https://unpkg.com/flare-plugin-sdk@0.1.0-beta.10/skill/flare-plugin/manifest.schema.json",
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "local.plugin.p1568372ac69c4df8a99cff8ad3f57936",
  "version": "0.2.2",
  "name": "Weibo Enhance",
  "description": "微博最新时间线与超话自动签到：刷新时间线时自动完成超话签到。",
  "permissions": {
    "authOrigins": [
      "https://passport.weibo.com",
      "https://passport.weibo.cn",
      "https://login.sina.com.cn"
    ],
    "mediaNetwork": true
  },
  "platform": {
    "id": "Plugin1568372ac69c4df8a99cff8ad3f57936",
    "name": "Weibo Enhance",
    "description": "微博增强版 (支持超话自动签到)",
    "loginMethods": [
      {
        "id": "browser",
        "interaction": "WebCookie",
        "title": "使用微博网页登录 (Weibo Enhance)",
        "cookie": {
          "startUrl": "$accountOrigin/",
          "probes": [
            {
              "url": "$accountOrigin/api/config",
              "cookies": [
                { "name": "SUB", "required": true },
                { "name": "SUBP", "required": false },
                { "name": "_T_WM", "required": false },
                { "name": "MLOGIN", "required": false },
                { "name": "ALF", "required": false },
                { "name": "XSRF-TOKEN", "required": false }
              ]
            }
          ]
        }
      }
    ],
    "capabilities": {
      "flare.datasource.timeline/v1": {
        "operations": {
          "page": {
            "directions": [
              "refresh",
              "older"
            ]
          }
        }
      }
    },
    "timelines": [
      {
        "id": "checkin",
        "title": "最新微博Enhance",
        "icon": "Home",
        "defaultForNewAccount": true
      }
    ]
  }
}
